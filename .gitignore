# ==========================================
# СЕКРЕТНЫЕ ДАННЫЕ
# ==========================================
.env
*.env
*.env.local
*.env.production
*.env.development

# Пароли Basic Auth
.htpasswd

# SSL-сертификаты (будут восстановлены вручную, но сама папка сохранится)
certs/*
!certs/.gitkeep

# ==========================================
# ДАННЫЕ n8n (база, настройки, исполнения)
# ==========================================
n8n_data/

# ==========================================
# СГЕНЕРИРОВАННЫЕ ИЗОБРАЖЕНИЯ (временные)
# ==========================================
ai-assistant/generated/*
!ai-assistant/generated/.gitkeep

# Статические изображения (логотип, заглушки и т.п.) НЕ игнорируются

# ==========================================
# ЛОГИ
# ==========================================
logs/*
!logs/.gitkeep

# ==========================================
# СИСТЕМНЫЕ ФАЙЛЫ
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Linux
*~
.directory
.Trash-*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# ==========================================
# DOCKER
# ==========================================
# Данные томов (содержат реальные данные)
pg_data/

# ==========================================
# РЕДАКТОРЫ И IDE
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ==========================================
# ЛОГИ
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# ВРЕМЕННЫЕ ФАЙЛЫ
# ==========================================
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig

# ==========================================
# АРХИВЫ (НЕ ИСХОДНЫЙ КОД)
# ==========================================
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# ==========================================
# СПЕЦИФИЧНЫЕ ФАЙЛЫ ПРОЕКТА
# ==========================================
# Сохранённые состояния n8n (если есть)
.n8n/

# Резервные копии базы данных
*.sql
*.dump
*.sql.gz

# Загруженные пользователями файлы (если появятся)
uploads/*
!uploads/.gitkeep
